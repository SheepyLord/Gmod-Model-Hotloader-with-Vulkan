diff --git a/src/wsi/sdl2/wsi_window_sdl2.cpp b/src/wsi/sdl2/wsi_window_sdl2.cpp
index 85413da..709b8f7 100644
--- a/src/wsi/sdl2/wsi_window_sdl2.cpp
+++ b/src/wsi/sdl2/wsi_window_sdl2.cpp
@@ -10,6 +10,7 @@
 
 #include <windows.h>
 #include <SDL_vulkan.h>
+#include <SDL_syswm.h>
 
 namespace dxvk::wsi {
 
@@ -176,9 +177,44 @@ namespace dxvk::wsi {
           VkSurfaceKHR*             pSurface) {
     SDL_Window* window = fromHwnd(hWindow);
 
-    return SDL_Vulkan_CreateSurface(window, instance, pSurface)
-         ? VK_SUCCESS
-         : VK_ERROR_OUT_OF_HOST_MEMORY;
+    if (SDL_GetWindowFlags(window) & SDL_WINDOW_VULKAN) {
+      return SDL_Vulkan_CreateSurface(window, instance, pSurface)
+           ? VK_SUCCESS
+           : VK_ERROR_OUT_OF_HOST_MEMORY;
+    }
+
+    // A window created for OpenGL (Garry's Mod's launcher creates its window
+    // before the renderer exists): SDL refuses such windows, so the surface is
+    // created on the native window, which can present through Vulkan as long
+    // as nothing swaps OpenGL buffers on it.
+    SDL_SysWMinfo info = { };
+    SDL_VERSION(&info.version);
+    if (!SDL_GetWindowWMInfo(window, &info)) {
+      Logger::err(str::format("SDL2 WSI: createSurface: SDL_GetWindowWMInfo: ", SDL_GetError()));
+      return VK_ERROR_INITIALIZATION_FAILED;
+    }
+
+    switch (info.subsystem) {
+      case SDL_SYSWM_X11: {
+        struct { VkStructureType sType; const void* pNext; VkFlags flags; void* dpy; unsigned long window; } createInfo = {
+          VK_STRUCTURE_TYPE_XLIB_SURFACE_CREATE_INFO_KHR, nullptr, 0, info.info.x11.display, info.info.x11.window };
+        using PFN = VkResult (VKAPI_PTR*)(VkInstance, const void*, const VkAllocationCallbacks*, VkSurfaceKHR*);
+        auto create = reinterpret_cast<PFN>(pfnVkGetInstanceProcAddr(instance, "vkCreateXlibSurfaceKHR"));
+        return create ? create(instance, &createInfo, nullptr, pSurface) : VK_ERROR_EXTENSION_NOT_PRESENT;
+      }
+#if SDL_VERSION_ATLEAST(2, 0, 2)
+      case SDL_SYSWM_WAYLAND: {
+        struct { VkStructureType sType; const void* pNext; VkFlags flags; void* display; void* surface; } createInfo = {
+          VK_STRUCTURE_TYPE_WAYLAND_SURFACE_CREATE_INFO_KHR, nullptr, 0, info.info.wl.display, info.info.wl.surface };
+        using PFN = VkResult (VKAPI_PTR*)(VkInstance, const void*, const VkAllocationCallbacks*, VkSurfaceKHR*);
+        auto create = reinterpret_cast<PFN>(pfnVkGetInstanceProcAddr(instance, "vkCreateWaylandSurfaceKHR"));
+        return create ? create(instance, &createInfo, nullptr, pSurface) : VK_ERROR_EXTENSION_NOT_PRESENT;
+      }
+#endif
+      default:
+        Logger::err(str::format("SDL2 WSI: createSurface: unsupported window system ", int(info.subsystem)));
+        return VK_ERROR_INITIALIZATION_FAILED;
+    }
   }
 
 }
