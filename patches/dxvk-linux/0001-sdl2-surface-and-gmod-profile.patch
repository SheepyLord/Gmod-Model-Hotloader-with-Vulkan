     if (!SDL_Vulkan_GetInstanceExtensions(nullptr, &extensionCount, extensionNames.data()))
       throw DxvkError(str::format("SDL2 WSI: Failed to get instance extensions. ", SDL_GetError()));
 
+    // createSurface() may have to use the X11 window directly (see there).
+    const char* videoDriver = SDL_GetCurrentVideoDriver();
+    if (videoDriver && !std::strcmp(videoDriver, "x11")) {
+      bool hasXlib = false;
+      for (const char* name : extensionNames)
+        hasXlib |= !std::strcmp(name, "VK_KHR_xlib_surface");
+      if (!hasXlib)
+        extensionNames.push_back("VK_KHR_xlib_surface");
+    }
+
     return extensionNames;
   }
 
