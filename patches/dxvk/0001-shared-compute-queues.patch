@@ -277,9 +279,80 @@ namespace dxvk {
 
     caps.queryDeviceQueues(&queueCount, queues.data());
 
+    // Shared compute queues (see DxvkDeviceQueueMapping): run below rendering.
+    // Their family gets a low global priority when DXVK uses none of its queues
+    // (DXVK_SHARED_COMPUTE_PRIORITY: low, the default, medium, high or off),
+    // and VK_NV_compute_occupancy_priority is enabled where available so that
+    // the application can lower its dispatches' SM occupancy priority too.
+    VkDeviceQueueGlobalPriorityCreateInfoKHR sharedPriority = { VK_STRUCTURE_TYPE_DEVICE_QUEUE_GLOBAL_PRIORITY_CREATE_INFO_KHR };
+    VkPhysicalDeviceComputeOccupancyPriorityFeaturesNV occupancyPriority = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_COMPUTE_OCCUPANCY_PRIORITY_FEATURES_NV };
+    const void* deviceNext = features->pNext;
+
+    if (queueMapping.sharedComputeCount) {
+      uint32_t supportedCount = 0u;
+      vk->vkEnumerateDeviceExtensionProperties(m_handle, nullptr, &supportedCount, nullptr);
+      std::vector<VkExtensionProperties> supported(supportedCount);
+      vk->vkEnumerateDeviceExtensionProperties(m_handle, nullptr, &supportedCount, supported.data());
+
+      auto hasExtension = [&] (const char* name, bool fromSupported) {
+        if (fromSupported) {
+          for (const auto& e : supported)
+            if (!std::strcmp(e.extensionName, name)) return true;
+          return false;
+        }
+        for (auto e : extensionNames)
+          if (!std::strcmp(e, name)) return true;
+        return false;
+      };
+
+      auto enableExtension = [&] (const char* name) {
+        if (!hasExtension(name, false))
+          extensionNames.push_back(name);
+      };
+
+      std::string setting = env::getEnvVar("DXVK_SHARED_COMPUTE_PRIORITY");
+      VkQueueGlobalPriorityKHR priority = VK_QUEUE_GLOBAL_PRIORITY_LOW_KHR;
+
+      if (setting == "medium") priority = VK_QUEUE_GLOBAL_PRIORITY_MEDIUM_KHR;
+      if (setting == "high")   priority = VK_QUEUE_GLOBAL_PRIORITY_HIGH_KHR;
+
+      bool exclusive = true;
+
+      for (auto used : { queueMapping.graphics, queueMapping.transfer, queueMapping.sparse })
+        exclusive &= used.family != queueMapping.sharedCompute.family;
+
+      const char* priorityExtension = hasExtension(VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME, true) ? VK_KHR_GLOBAL_PRIORITY_EXTENSION_NAME
+        : hasExtension(VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME, true) ? VK_EXT_GLOBAL_PRIORITY_EXTENSION_NAME : nullptr;
+
+      if (setting != "off" && exclusive && priorityExtension) {
+        for (auto& q : queues) {
+          if (q.queueFamilyIndex == queueMapping.sharedCompute.family) {
+            sharedPriority.globalPriority = priority;
+            sharedPriority.pNext = q.pNext;
+            q.pNext = &sharedPriority;
+            enableExtension(priorityExtension);
+            Logger::info(str::format("Shared compute queues: global priority ", uint32_t(priority)));
+          }
+        }
+      }
+
+      if (hasExtension(VK_NV_COMPUTE_OCCUPANCY_PRIORITY_EXTENSION_NAME, true)) {
+        VkPhysicalDeviceFeatures2 query = { VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2 };
+        query.pNext = &occupancyPriority;
+        vk->vkGetPhysicalDeviceFeatures2(m_handle, &query);
+
+        if (occupancyPriority.computeOccupancyPriority) {
+          occupancyPriority.pNext = const_cast<void*>(deviceNext);
+          deviceNext = &occupancyPriority;
+          enableExtension(VK_NV_COMPUTE_OCCUPANCY_PRIORITY_EXTENSION_NAME);
+          Logger::info("Shared compute queues: compute occupancy priority available");
+        }
+      }
+    }
+
     // Create the actual Vulkan device
     VkDeviceCreateInfo deviceInfo = { VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO };
-    deviceInfo.pNext = features->pNext;
+    deviceInfo.pNext = deviceNext;
     deviceInfo.queueCreateInfoCount = queues.size();
     deviceInfo.pQueueCreateInfos = queues.data();
     deviceInfo.enabledExtensionCount = extensionNames.size();
@@ -301,6 +374,8 @@ namespace dxvk {
     deviceQueues.graphics = getDeviceQueue(vkd, caps, queueMapping.graphics);
     deviceQueues.transfer = getDeviceQueue(vkd, caps, queueMapping.transfer);
     deviceQueues.sparse   = getDeviceQueue(vkd, caps, queueMapping.sparse);
+    deviceQueues.sharedCompute = getDeviceQueue(vkd, caps, queueMapping.sharedCompute);
+    deviceQueues.sharedComputeCount = queueMapping.sharedComputeCount;
 
     return new DxvkDevice(m_instance, this, vkd, caps, deviceQueues, DxvkQueueCallback());
   }
