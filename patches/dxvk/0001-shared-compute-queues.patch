diff --git a/src/d3d9/d3d9_shared_compute.cpp b/src/d3d9/d3d9_shared_compute.cpp
new file mode 100644
index 0000000..be97c71
--- /dev/null
+++ b/src/d3d9/d3d9_shared_compute.cpp
@@ -0,0 +1,98 @@
+#include "d3d9_device.h"
+#include "d3d9_shared_compute.h"
+
+#include "../dxvk/dxvk_instance.h"
+
+#include <new>
+
+namespace dxvk {
+
+  static dxvk::mutex   g_sharedComputeMutex;
+  static D3D9DeviceEx* g_sharedComputeDevice = nullptr;
+
+  void D3D9RegisterSharedComputeDevice(D3D9DeviceEx* pDevice) {
+    std::lock_guard<dxvk::mutex> lock(g_sharedComputeMutex);
+    g_sharedComputeDevice = pDevice;
+
+    const auto& queues = pDevice->GetDXVKDevice()->queues();
+
+    if (queues.sharedComputeCount) {
+      Logger::info(str::format("D3D9: Shared compute queues: family ", queues.sharedCompute.queueFamily,
+        ", first ", queues.sharedCompute.queueIndex, ", count ", queues.sharedComputeCount));
+    }
+  }
+
+  void D3D9UnregisterSharedComputeDevice(D3D9DeviceEx* pDevice) {
+    std::lock_guard<dxvk::mutex> lock(g_sharedComputeMutex);
+
+    if (g_sharedComputeDevice == pDevice)
+      g_sharedComputeDevice = nullptr;
+  }
+
+  // What Acquire hands out as the owner: a reference on DXVK's device, never
+  // one on the D3D9 device. A D3D9 device whose final Release is already in
+  // its destructor, waiting on the registry lock, must not be AddRef'd back.
+  struct D3D9SharedComputeToken {
+    Rc<DxvkDevice> device;
+  };
+
+  static D3D9SharedComputeToken* SharedComputeToken(void* pOwner) {
+    return static_cast<D3D9SharedComputeToken*>(pOwner);
+  }
+
+}
+
+extern "C" {
+
+  DLLEXPORT HRESULT __stdcall DXVK_AcquireSharedComputeQueue(DXVK_SHARED_COMPUTE_QUEUE* pQueue) {
+    using namespace dxvk;
+
+    if (!pQueue || pQueue->Version != DXVK_SHARED_COMPUTE_QUEUE_VERSION)
+      return D3DERR_INVALIDCALL;
+
+    std::lock_guard<dxvk::mutex> lock(g_sharedComputeMutex);
+
+    if (!g_sharedComputeDevice)
+      return D3DERR_NOTAVAILABLE;
+
+    // A destructor unregisters its device before tearing anything down, and
+    // this lock orders the two, so the device's members are still intact
+    // here. The copied reference then keeps the Vulkan device, its adapter
+    // and instance alive on its own; waitForIdle takes the shared lock.
+    Rc<DxvkDevice> device = g_sharedComputeDevice->GetDXVKDevice();
+    const auto& queues = device->queues();
+
+    if (!queues.sharedComputeCount)
+      return D3DERR_NOTAVAILABLE;
+
+    auto token = new (std::nothrow) D3D9SharedComputeToken { device };
+
+    if (!token)
+      return E_OUTOFMEMORY;
+
+    pQueue->Instance            = device->instance()->handle();
+    pQueue->PhysicalDevice      = device->adapter()->handle();
+    pQueue->Device              = device->handle();
+    pQueue->GetInstanceProcAddr = device->instance()->vki()->getLoaderProc();
+    pQueue->QueueFamilyIndex    = queues.sharedCompute.queueFamily;
+    pQueue->FirstQueueIndex     = queues.sharedCompute.queueIndex;
+    pQueue->QueueCount          = queues.sharedComputeCount;
+    pQueue->Owner               = token;
+    return D3D_OK;
+  }
+
+  DLLEXPORT void __stdcall DXVK_LockSharedComputeQueue(void* pOwner) {
+    if (pOwner)
+      dxvk::SharedComputeToken(pOwner)->device->lockSharedCompute();
+  }
+
+  DLLEXPORT void __stdcall DXVK_UnlockSharedComputeQueue(void* pOwner) {
+    if (pOwner)
+      dxvk::SharedComputeToken(pOwner)->device->unlockSharedCompute();
+  }
+
+  DLLEXPORT void __stdcall DXVK_ReleaseSharedComputeQueue(void* pOwner) {
+    delete dxvk::SharedComputeToken(pOwner);
+  }
+
+}
diff --git a/src/d3d9/d3d9_shared_compute.h b/src/d3d9/d3d9_shared_compute.h
new file mode 100644
index 0000000..d15b6ea
--- /dev/null
+++ b/src/d3d9/d3d9_shared_compute.h
@@ -0,0 +1,61 @@
+#pragma once
+
+// Shared compute queues: a process can run its own Vulkan compute work on the
+// VkDevice that renders its D3D9 content, on queues of a dedicated compute
+// family that DXVK creates but never uses. Work there overlaps rendering in
+// one GPU context instead of being time-sliced against a second device.
+//
+//   DXVK_SHARED_COMPUTE_QUEUE q = { DXVK_SHARED_COMPUTE_QUEUE_VERSION };
+//   if (SUCCEEDED(DXVK_AcquireSharedComputeQueue(&q))) {
+//     vkGetDeviceQueue(q.Device, q.QueueFamilyIndex, q.FirstQueueIndex + i, &queue);
+//     DXVK_LockSharedComputeQueue(q.Owner);    // around vkQueueSubmit and
+//     vkQueueSubmit(queue, ...);               // vkQueueWaitIdle only
+//     DXVK_UnlockSharedComputeQueue(q.Owner);
+//     ...
+//     DXVK_ReleaseSharedComputeQueue(q.Owner); // after destroying every object
+//   }                                          // created on q.Device
+//
+// The handles come from the most recently created D3D9 device. Acquire keeps
+// its VkDevice and VkInstance alive until the matching release, even after
+// the D3D9 device itself is destroyed; Owner is an opaque token, not the
+// device. Never destroy the device or instance, and never call
+// vkDeviceWaitIdle on it.
+
+#include <stdint.h>
+
+#ifdef _WIN32
+#include <windows.h>
+#endif
+
+#include <vulkan/vulkan.h>
+
+#define DXVK_SHARED_COMPUTE_QUEUE_VERSION 1u
+
+typedef struct DXVK_SHARED_COMPUTE_QUEUE {
+  uint32_t                  Version;          // in: DXVK_SHARED_COMPUTE_QUEUE_VERSION
+  VkInstance                Instance;
+  VkPhysicalDevice          PhysicalDevice;
+  VkDevice                  Device;
+  PFN_vkGetInstanceProcAddr GetInstanceProcAddr;
+  uint32_t                  QueueFamilyIndex;
+  uint32_t                  FirstQueueIndex;
+  uint32_t                  QueueCount;
+  void*                     Owner;            // for Lock/Unlock/Release
+} DXVK_SHARED_COMPUTE_QUEUE;
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef HRESULT (__stdcall *PFN_DXVK_AcquireSharedComputeQueue)(DXVK_SHARED_COMPUTE_QUEUE* pQueue);
+typedef void    (__stdcall *PFN_DXVK_SharedComputeQueueOwner)(void* pOwner);
+
+#ifdef __cplusplus
+}
+
+namespace dxvk {
+  class D3D9DeviceEx;
+  void D3D9RegisterSharedComputeDevice(D3D9DeviceEx* pDevice);
+  void D3D9UnregisterSharedComputeDevice(D3D9DeviceEx* pDevice);
+}
+#endif
